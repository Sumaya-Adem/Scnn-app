<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    tools:context=".SignInScreens.SignInFragment">

    <LinearLayout
        android:id="@+id/lneng"
        android:layout_width="137dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="10dp"
        android:gravity="center"
        android:background="@drawable/language_box"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="24dp"
            android:layout_weight="1"
            android:layout_height="24dp"
            android:src="@drawable/message_translate"/>
        <TextView
            android:id="@+id/tvEnglish"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="English"
            android:textSize="14sp"
            android:fontFamily="@font/aeoniktrail_regular"
            android:textColor="@color/green"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:src="@drawable/arrow_down_24"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="684dp"
        android:layout_marginTop="0dp"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lneng">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/faras2"
            android:layout_gravity="center"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome Back!"
            android:fontFamily="@font/aeoniktrail_bold"
            android:textSize="23sp"
            android:layout_marginTop="10dp"
            android:layout_gravity="center"
            android:drawablePadding="10dp"
            android:drawableEnd="@drawable/wave"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="To get started, sign in to your account"
            android:textColor="@color/grey"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textSize="18sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:orientation="horizontal"
            android:layout_gravity="center">
            <LinearLayout
                android:layout_width="129dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:layout_marginEnd="10dp"
                android:background="@drawable/edit_text_bg">
                <com.hbb20.CountryCodePicker
                    android:id="@+id/countryCodePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:ccp_defaultNameCode="US"
                    app:ccp_showFlag="true"
                    app:ccp_showFullName="false"/>

            </LinearLayout>
            <com.google.android.material.textfield.TextInputEditText

                android:layout_width="249dp"
                android:layout_height="58dp"
                android:id="@+id/signup_number"
                android:ems="10"
                android:inputType="phone"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingEnd="20dp"
                android:paddingStart="20dp"
                android:textSize="16sp"
                android:layout_gravity="center"
                android:fontFamily="@font/aeoniktrail_regular"
                android:hint="Mobile number"
                android:textFontWeight="400"
                android:textColorHint="@color/input_grey_text"
                android:textColor="@color/black"
                android:background="@drawable/edit_text_bg"/>
        </LinearLayout>
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="380dp"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:id="@+id/signup_name"
            android:ems="10"
            android:inputType="text"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingEnd="20dp"
            android:paddingStart="20dp"
            android:textSize="16sp"
            android:fontFamily="@font/aeoniktrail_regular"
            android:hint="Enter full name"
            android:textFontWeight="400"
            android:layout_gravity="center"
            android:textColorHint="@color/input_grey_text"
            android:textColor="@color/black"
            android:background="@drawable/edit_text_bg"/>
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="380dp"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:id="@+id/email_sign_up"
            android:ems="10"
            android:inputType="text"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingEnd="20dp"
            android:paddingStart="20dp"
            android:textSize="16sp"
            android:fontFamily="@font/aeoniktrail_regular"
            android:hint="Enter email address"
            android:textFontWeight="400"
            android:layout_gravity="center"
            android:textColorHint="@color/input_grey_text"
            android:textColor="@color/black"
            android:background="@drawable/edit_text_bg"/>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/passwordLayout"
            android:layout_width="380dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:endIconMode="password_toggle"
            app:endIconDrawable="@drawable/view_off_slash"
            android:hint="Password">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:inputType="textPassword"
                android:ems="10"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingEnd="20dp"
                android:paddingStart="20dp"
                android:textSize="16sp"
                android:fontFamily="@font/aeoniktrail_regular"
                android:textColorHint="@color/input_grey_inside"
                android:textColor="@color/black"
                android:background="@drawable/edit_text_bg"/>
        </com.google.android.material.textfield.TextInputLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/my_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remember me "
                android:layout_marginStart="6dp"
                android:padding="16dp"
                android:textSize="18sp"
                android:textFontWeight="400"
                android:fontFamily="@font/aeoniktrail_regular"
                android:button="@drawable/checkbox"
                android:checked="false"/>

        </LinearLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/signup_btn"
            android:layout_width="390dp"
            android:layout_height="60dp"
            android:background="@drawable/btn"
            android:text="Sign Up"
            android:layout_marginTop="40dp"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:lineHeight="28dp"
            android:textFontWeight="500"
            android:fontFamily="@font/aeoniktrail_regular"
            android:textAllCaps="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/aeoniktrail_regular"
                android:text="@string/Dont_have"
                android:textFontWeight="400"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/to_sign_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/aeoniktrail_bold"
                android:text="Sign In"
                android:textColor="@color/green"
                android:textFontWeight="400"
                android:textSize="16sp" />

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>