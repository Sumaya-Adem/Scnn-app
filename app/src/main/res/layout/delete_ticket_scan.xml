<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:background="@drawable/congrts_dialog_bg"
    android:padding="16dp"

    android:gravity="center">



    <!-- Title Text View -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete Ticket Scan"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:gravity="center"/>
    <View
        android:layout_width="690dp"
        android:layout_height="2dp"
        android:layout_marginTop="20dp"
        android:background="@color/input_grey_outside"/>

    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Are you sure you want to delete this ticket\n scan from your history "
        android:textSize="16sp"
        android:textAlignment="center"
        android:textColor="#6B6B6E"
        android:fontFamily="@font/aeoniktrail_regular"
        android:layout_marginTop="8dp"
        android:layout_gravity="center"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="10dp"
        android:orientation="horizontal">
    <!-- Action Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cancel"
            android:layout_width="149dp"
            android:layout_height="58dp"
            android:background="@drawable/btn"
            android:textAllCaps="false"
            android:padding="16dp"
            android:backgroundTint="#F8F8F8"
            android:layout_marginEnd="10dp"
            android:text="No, don't"
            android:textColor="@color/black"
            android:fontFamily="@font/aeoniktrail_bold"
            />
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/yes_confirm"
        android:layout_width="149dp"
        android:layout_height="58dp"
        android:background="@drawable/btn"
        android:textAllCaps="false"
        android:layout_marginStart="10dp"
        android:padding="16dp"
        android:backgroundTint="@color/red"
        android:text="Yes,delete"
        android:textColor="@color/white"
        android:fontFamily="@font/aeoniktrail_bold"
       />
    </LinearLayout>
</LinearLayout>