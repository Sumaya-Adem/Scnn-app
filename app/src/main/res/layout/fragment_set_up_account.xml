<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".SignUpScreens.SetUpAccountFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">
            <ImageView
                android:id="@+id/back_icon_btn"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/arrow_left_02"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="74dp"
                android:fontFamily="@font/aeoniktrail_bold"
                android:textSize="23sp"
                android:text="Set Up Account"/>

        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
        <LinearLayout
            android:layout_width="398dp"
            android:layout_height="490dp"
            android:layout_marginTop="44dp"
            android:orientation="vertical">


<LinearLayout
    android:layout_width="150dp"
    android:layout_height="150dp"
    android:layout_gravity="center"
    android:gravity="center"
    android:background="@drawable/user_bg">

    <ImageView
        android:id="@+id/user_profile_photo"
        android:layout_width="wrap_content"
        android:layout_height="90dp"
        android:src="@drawable/user"
        />
</LinearLayout>
            <LinearLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:layout_marginTop="-50dp"
                android:layout_marginStart="50dp"
                android:gravity="center"
                android:background="@drawable/active_dot">
                <ImageView
                    android:id="@+id/new_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/camera"/>

            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:layout_gravity="center">
                <LinearLayout
                    android:layout_width="129dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/edit_text_bg">
                    <com.hbb20.CountryCodePicker
                        android:id="@+id/countryCodePicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:ccp_defaultNameCode="US"
                        app:ccp_showFlag="true"
                        app:ccp_showFullName="false"/>

                </LinearLayout>
                <com.google.android.material.textfield.TextInputEditText

                    android:layout_width="249dp"
                    android:layout_height="58dp"
                    android:id="@+id/signup_number"
                    android:ems="10"
                    android:inputType="phone"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:paddingEnd="20dp"
                    android:paddingStart="20dp"
                    android:textSize="16sp"
                    android:layout_gravity="center"
                    android:fontFamily="@font/aeoniktrail_regular"
                    android:hint="Mobile number"
                    android:textFontWeight="400"
                    android:textColorHint="@color/input_grey_text"
                    android:textColor="@color/black"
                    android:background="@drawable/edit_text_bg"/>
            </LinearLayout>

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="380dp"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:id="@+id/setup_name"
            android:ems="10"
            android:inputType="text"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingEnd="20dp"
            android:paddingStart="20dp"
            android:textSize="16sp"
            android:fontFamily="@font/aeoniktrail_regular"
            android:hint="Enter full name"
            android:textFontWeight="400"
            android:layout_gravity="center"
            android:textColorHint="@color/input_grey_text"
            android:textColor="@color/black"
            android:background="@drawable/edit_text_bg"/>
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="380dp"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:id="@+id/email_set_up"
            android:ems="10"
            android:inputType="text"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingEnd="20dp"
            android:paddingStart="20dp"
            android:textSize="16sp"
            android:fontFamily="@font/aeoniktrail_regular"
            android:hint="Enter email address"
            android:textFontWeight="400"
            android:layout_gravity="center"
            android:textColorHint="@color/input_grey_text"
            android:textColor="@color/black"
            android:background="@drawable/edit_text_bg"/>
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="380dp"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:id="@+id/organizer"
                android:ems="10"
                android:inputType="text"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingEnd="20dp"
                android:paddingStart="20dp"
                android:textSize="16sp"
                android:fontFamily="@font/aeoniktrail_regular"
                android:hint="Account type"
                android:textFontWeight="400"
                android:layout_gravity="center"
                android:textColorHint="#959595"
                android:textColor="@color/black"
                android:drawableEnd="@drawable/arrow_down_grn"
                android:background="@drawable/edit_text_bg"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="171dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/continue_btn"
                android:layout_width="390dp"
                android:layout_height="60dp"
                android:background="@drawable/btn"
                android:text="Continue"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:lineHeight="28dp"
                android:textFontWeight="500"
                android:fontFamily="@font/aeoniktrail_regular"
                android:textAllCaps="false"
                />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>