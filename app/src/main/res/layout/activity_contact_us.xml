<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".HomeScreen.ContactUsActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:background="@color/white"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/back_icon_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/arrow_left_02"/>

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:fontFamily="@font/aeoniktrail_bold"
            android:textSize="23sp"
            android:text="Contact Us"/>
    </androidx.appcompat.widget.Toolbar>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="189dp"
            android:layout_marginBottom="10dp"

            android:orientation="vertical">
            <LinearLayout
                android:layout_width="124dp"
                android:layout_height="124dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:background="@drawable/user_bg">

                <ImageView
                    android:id="@+id/user_profile_photo"
                    android:layout_width="wrap_content"
                    android:layout_height="90dp"
                    android:src="@drawable/user"
                    />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Abrahan John"
                android:fontFamily="@font/aeoniktrail_bold"
                android:textSize="23sp"
                android:layout_marginTop="10dp"
                android:layout_gravity="center"
                android:drawablePadding="10dp"
                />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="abrahamjo333@gmail.com"
                android:textColor="@color/black"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="18sp"/>
        </LinearLayout>

        <!--    <com.google.android.material.textfield.TextInputLayout-->
        <!--        android:id="@+id/text_layout"-->
        <!--        android:layout_width="match_parent"-->
        <!--        android:layout_height="wrap_content"-->
        <!--        android:layout_marginTop="16dp"-->
        <!--        android:hint="Select title"-->
        <!--        >-->

        <!--        <com.google.android.material.textfield.TextInputEditText-->
        <!--            android:id="@+id/title_input"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="58dp"-->
        <!--            android:textColorHint="#959595"-->
        <!--            android:textSize="16sp"-->
        <!--            android:background="@drawable/edit_text_bg"-->
        <!--            android:gravity="start"-->
        <!--            android:layout_gravity="center"-->
        <!--            android:drawableEnd="@drawable/arrow_dooown" />-->
        <!--    </com.google.android.material.textfield.TextInputLayout>-->
        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:id="@+id/title_input"
            android:ems="10"
            android:inputType="none"
            android:drawableEnd="@drawable/arrow_dooown"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:paddingEnd="20dp"
            android:paddingStart="20dp"
            android:textSize="16sp"
            android:fontFamily="@font/aeoniktrail_regular"
            android:hint="Select title"
            android:textFontWeight="400"
            android:layout_gravity="center"
            android:textColorHint="@color/grey"
            android:textColor="@color/black"
            android:background="@drawable/edit_text_bg"/>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"

            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/feedback_text"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:textColorHint="#959595"
                android:hint="Please write your feedback"
                android:textSize="16sp"
                android:background="@drawable/edit_text_bg"
                android:gravity="start"
                />
        </com.google.android.material.textfield.TextInputLayout>
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/signup_btn"
            android:layout_width="398dp"
            android:layout_height="60dp"
            android:background="@drawable/btn"
            android:text="Submit"
            android:paddingLeft="50dp"
            android:paddingBottom="14dp"
            android:paddingTop="14dp"
            android:paddingRight="50dp"
            android:layout_gravity="center"
            android:layout_marginTop="20dp"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:lineHeight="28dp"
            android:textFontWeight="500"
            android:fontFamily="@font/aeoniktrail_regular"
            android:textAllCaps="false"
            />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAlignment="center"
            android:text="Get in touch with us"
            android:textSize="20sp"
            android:fontFamily="@font/aeoniktrail_regular"
            android:textFontWeight="400"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:gravity="center"
            android:orientation="horizontal"
            >
            <LinearLayout
                android:layout_width="69dp"
                android:layout_height="85dp"
                android:orientation="vertical"
                android:gravity="center"
                >
                <ImageView
                    android:id="@+id/call_planner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/calling"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Call Planner"
                    android:textSize="12sp"
                    android:fontFamily="@font/aeoniktrail_regular"
                    android:textColor="#8E8E93"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="69dp"
                android:layout_height="85dp"
                android:layout_marginHorizontal="30dp"
                android:orientation="vertical"
                android:gravity="center"
                >
                <ImageView
                    android:id="@+id/talegram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/talegram"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telegram"
                    android:textSize="12sp"
                    android:fontFamily="@font/aeoniktrail_regular"
                    android:textColor="#8E8E93"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="69dp"
                android:layout_height="85dp"
                android:orientation="vertical"
                android:layout_marginHorizontal="0dp"
                android:gravity="center"
                >
                <ImageView
                    android:id="@+id/facebook"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:src="@drawable/fb"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Call Planner"
                    android:textSize="12sp"
                    android:fontFamily="@font/aeoniktrail_regular"
                    android:textColor="#8E8E93"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>


</LinearLayout>