<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="398dp"
    android:layout_height="126dp"
    android:orientation="horizontal"
    android:layout_marginVertical="8dp"
    android:background="@drawable/all_corner_radious"
    >
        <ImageView
            android:id="@+id/event_image"
            android:layout_width="115dp"
            android:layout_height="106dp"
            android:layout_margin="10dp"
            android:src="@drawable/moshing"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="222dp"
            android:layout_height="86dp"
            android:layout_gravity="center">
            <TextView
                android:id="@+id/event_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Moshing Fest 2024"
                android:textSize="18sp"
                android:fontFamily="@font/aeoniktrail_bold"
                tools:ignore="MissingConstraints" />
            <TextView
                android:id="@+id/event_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wed, Jan 18"
                android:textSize="16sp"
                android:textColor="@color/green"
                android:fontFamily="@font/aeoniktrail_regular"
               app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/event_title"/>
                <View

                    android:id="@+id/divider"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/active_dot"
                    android:layout_marginTop="16dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    app:layout_constraintStart_toEndOf="@id/event_date"
                    app:layout_constraintTop_toBottomOf="@id/event_title"/>
            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="18:00 - 22:00PM"
                android:textSize="16sp"
                android:textColor="@color/green"
                android:fontFamily="@font/aeoniktrail_regular"
                android:layout_marginStart="5dp"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toEndOf="@id/divider"
                app:layout_constraintTop_toBottomOf="@id/event_title"/>
            <ImageView
                android:id="@+id/location_img"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/location"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/event_date"/>
            <TextView
                android:id="@+id/location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jombang, East Java"
                android:textColor="#9E9E9E"
                android:textSize="14sp"
                android:layout_marginStart="5dp"
                android:layout_marginTop="15dp"
                app:layout_constraintStart_toEndOf="@id/location_img"
                app:layout_constraintTop_toBottomOf="@id/divider"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>