<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Scan.ScanActivity"

    >
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/barcode_scanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#012C0D59"
        />
        <ImageView
            android:id="@+id/cancel_scan"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/cancel_01"
            android:layout_marginTop="69dp"
            android:layout_marginStart="16dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="23sp"
            android:textColor="@color/white"
            android:text="Scan"
            android:fontFamily="@font/aeoniktrail_regular"
            android:layout_marginTop="69dp"
            android:layout_marginStart="188dp"
            />

        <LinearLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:background="@drawable/flash_gallery_bg"
            android:layout_marginTop="800dp"
            android:layout_marginStart="16dp">
            <ImageView
                android:id="@+id/btnFlash"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/flash_off"
                android:contentDescription="Flash Toggle"
                />

        </LinearLayout>
        <LinearLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:layout_marginTop="800dp"
            android:layout_marginLeft="186dp"
            android:background="@drawable/green_stoke_green">

            <ImageView
                android:id="@+id/scanning"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/scan_inscan"
                android:contentDescription="Flash Toggle"
                />

        </LinearLayout>

            <!-- Open Gallery -->

        <LinearLayout
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:gravity="center"
            android:layout_marginTop="800dp"
            android:layout_marginLeft="340dp"
            android:background="@drawable/flash_gallery_bg">

            <ImageView
                android:id="@+id/gallery"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/gallery"
                android:contentDescription="Flash Toggle"
                />

        </LinearLayout>
    <include
        layout="@layout/scan_ovelay"/>
</RelativeLayout>