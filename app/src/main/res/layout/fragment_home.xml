<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    tools:context=".HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        >
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_gravity="center">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profileImage"
                android:layout_width="47dp"
                android:layout_height="47dp"
                android:background="@drawable/profile_bg"
                android:src="@drawable/abrham"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/welcomeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back"
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:fontFamily="@font/aeoniktrail_regular"
                />
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/wave"
                android:layout_marginStart="100dp"
                android:layout_marginTop="-15dp"/>

            <!-- Profile Name -->
            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Abraham"
                android:fontFamily="@font/aeoniktrail_bold"
                android:textSize="16sp"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnlogout"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="165dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@drawable/logout_bg"
           >
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/logout"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="70dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/scan"
             />
        <TextView
            android:id="@+id/noTicketMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Ticket Scan"
            android:layout_marginTop="10dp"
            android:textSize="20sp"
            android:fontFamily="@font/aeoniktrail_regular"
            android:textStyle="bold"
           />

        <!-- Ticket Scan Description -->
        <TextView
            android:id="@+id/ticketScanDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="You currently haven’t scanned any event ticket yet"
            android:textSize="16sp"
            android:fontFamily="@font/aeoniktrail_regular"
            android:textColor="#A0A0A0"
            />
    </LinearLayout>
