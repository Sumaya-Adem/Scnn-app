<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="250dp"
    android:background="@drawable/dialog_bg"
    android:padding="16dp"
    android:gravity="center">



    <!-- Title Text View -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log Out "
        android:textSize="18sp"
        android:textColor="@color/black"
        android:textStyle="bold"

        android:gravity="center"/>

    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Are you sure you want to log out "
        android:textSize="16sp"
        android:textColor="#6B6B6E"
        android:fontFamily="@font/aeoniktrail_regular"
        android:layout_marginTop="8dp"
        android:layout_gravity="center"/>

    <!-- Action Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/yes_logout"
        android:layout_width="370dp"
        android:layout_height="58dp"
        android:background="@drawable/btn"
        android:textAllCaps="false"
        android:backgroundTint="@color/red"
        android:text="Yes,log out"
        android:textColor="@color/white"
        android:fontFamily="@font/aeoniktrail_bold"
        android:layout_marginTop="16dp"/>
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/cancel"
        android:layout_width="370dp"
        android:layout_height="58dp"
        android:background="@drawable/btn"
        android:textAllCaps="false"
        android:backgroundTint="#F8F8F8"
        android:layout_marginBottom="10dp"
        android:text="Cancel"
        android:textColor="@color/black"
        android:fontFamily="@font/aeoniktrail_bold"
        android:layout_marginTop="16dp"/>
</LinearLayout>