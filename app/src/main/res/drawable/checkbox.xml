<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- When checked, use the 'checked' drawable -->
    <item android:drawable="@drawable/ic_checkbox_checked"
        android:state_checked="true"
        />
    <!-- When unchecked, use the 'unchecked' drawable -->
    <item android:drawable="@drawable/ic_checkbox_unchecked" android:state_checked="false" />
</selector>